# Global config. Copy to .env. Per-product X credentials live in products/<slug>/.env.

# dry_run (default) or live. Live publishing also needs per-product X credentials.
AUTOCM_MODE=dry_run
# 1 = global kill switch for publishing
AUTOCM_PAUSED=0
# claude (default, uses your Claude Code login) or fake (fixtures, for tests)
AUTOCM_LLM=claude
# Max posts per day across all products
AUTOCM_GLOBAL_DAILY_CAP=6
LOG_LEVEL=info

# Optional AI media providers. Without keys, templates and Remotion are used.
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
# 1 = allow AI video generation (needs FAL_KEY; costs money per clip)
AUTOCM_AI_VIDEO=0
